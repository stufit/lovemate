{
  "name": "woorisai-lab",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @woorisai/api --filter @woorisai/web dev",
    "build": "pnpm --filter @woorisai/api build && pnpm --filter @woorisai/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @woorisai/api db:migrate",
    "db:revert": "pnpm --filter @woorisai/api db:revert",
    "db:seed": "pnpm --filter @woorisai/api db:seed",
    "db:purge": "pnpm --filter @woorisai/api db:purge",
    "format": "prettier --write apps packages tests *.ts *.json pnpm-workspace.yaml"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "prettier": "^3.10.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "type": "module"
}
