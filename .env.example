NODE_ENV=development
WEB_BASE_URL=http://127.0.0.1:3200
API_BASE_URL=http://127.0.0.1:4000
PORT=4000
# Existing local Docker PostgreSQL. Set your own user/password.
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:1992/woorisai_lab
